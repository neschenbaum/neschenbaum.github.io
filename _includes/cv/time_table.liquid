<div class="entries">
  {% for content in entry.contents %}
    <div class="entry">
      <div class="entry-date">{{ content.year | replace: ' - ', ' – ' }}</div>
      <div class="entry-body">
        {% if content.title %}
          <div class="entry-title">{{ content.title }}</div>
        {% endif %}
        {% if content.institution %}
          <div class="entry-meta">{{ content.institution }}</div>
        {% endif %}
        {% for item in content.description %}
          <div class="entry-text">{{ item }}</div>
        {% endfor %}
      </div>
    </div>
  {% endfor %}
</div>
